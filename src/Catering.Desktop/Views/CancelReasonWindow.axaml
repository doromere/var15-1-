<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Catering.Desktop.ViewModels"
        x:Class="Catering.Desktop.Views.CancelReasonWindow"
        Title="Отмена договора · указание причины"
        Width="520" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <Border Classes="Card" Margin="16">
    <StackPanel Spacing="12">
      <TextBlock Classes="H2" Text="Отмена договора клиентом" />
      <TextBlock Text="Операция отмены возможна из любого незакрытого статуса и требует обязательную причину. Причина попадёт в документ и будет экспортирована в смету."
                 TextWrapping="Wrap" FontSize="12" Foreground="#6B5E4E" LineHeight="18" />

      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="Caption" Text="ПРИЧИНА ОТМЕНЫ" />
          <TextBlock Grid.Column="1" Text="{Binding ReasonLengthText}" FontSize="10" Foreground="#6B5E4E" />
        </Grid>
        <TextBox Text="{Binding Reason, Mode=TwoWay}"
                 Watermark="например: клиент перенёс мероприятие на другую дату…"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="96"
                 MaxLength="1000" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Padding="16,10" Command="{Binding CancelCommand}" Content="Не отменять" />
        <Button Classes="Accent" Padding="16,10" Command="{Binding ConfirmCommand}"
                IsEnabled="{Binding CanConfirm}"
                Content="Подтвердить отмену" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
