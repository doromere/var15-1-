<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Catering.Desktop.ViewModels"
        x:Class="Catering.Desktop.Views.LoginWindow"
        Title="Кейтеринг «Сибирский стол» · Авторизация"
        Width="960" Height="560"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        CanResize="True">

  <Grid ColumnDefinitions="5*,6*">

    <!-- Логотип / описание компании -->
    <Border Grid.Column="0" Background="#213B2C" Padding="42,36">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
          <Image Source="avares://Catering.Desktop/Assets/logo.png" Width="96" Height="96"
                 HorizontalAlignment="Left" Margin="0,0,0,8" />
          <TextBlock Text="ПР23 · КТР · УП.01.01" FontSize="11" FontWeight="SemiBold"
                     Foreground="#C9A227" />
          <TextBlock Text="СИБИРСКИЙ СТОЛ" FontFamily="Georgia, 'Times New Roman', serif"
                     FontSize="34" FontWeight="Bold" Foreground="#F7F3EB" />
          <TextBlock Text="кейтеринговая компания" FontSize="13" Foreground="#B9C8BC" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="18">
          <Border BorderBrush="#3F5A49" BorderThickness="0,1,0,0" />
          <TextBlock Text="Выездное ресторанное обслуживание банкетов и корпоративных мероприятий полного цикла — от сметы до подачи десерта."
                     TextWrapping="Wrap" FontSize="14" Foreground="#E7E0D0" LineHeight="22" />
          <StackPanel Spacing="10">
            <TextBlock Text="· Калькуляция смет: площадка ×1.25 для открытых площадок, +500 ₽ за персону персонала, VIP-льгота 10%"
                       TextWrapping="Wrap" Foreground="#B9C8BC" FontSize="12" LineHeight="18" />
            <TextBlock Text="· Мастер-документ: договор + спецификация блюд, пересчёт итогов на лету"
                       TextWrapping="Wrap" Foreground="#B9C8BC" FontSize="12" LineHeight="18" />
            <TextBlock Text="· Контроль выезда шеф-повара в реальном времени (таймер обратного отсчёта)"
                       TextWrapping="Wrap" Foreground="#B9C8BC" FontSize="12" LineHeight="18" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="2">
          <TextBlock Text="ООО «Сибирский стол»" FontWeight="SemiBold" Foreground="#F7F3EB" FontSize="12" />
          <TextBlock Text="г. Кемерово · будние дни 08:00–20:00 · +7 (384) 221-30-40"
                     Foreground="#8FA797" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Форма авторизации -->
    <Grid Grid.Column="1" Background="#F7F3EB">
      <Border Classes="Card" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,28">
        <StackPanel Spacing="10">
          <TextBlock Classes="H2" Text="Вход в систему" />
          <TextBlock Classes="Caption" Text="АУТЕНТИФИКАЦИЯ СОТРУДНИКА" />

          <StackPanel Spacing="4" Margin="0,8,0,0">
            <TextBlock Classes="Caption" Text="ЛОГИН" />
            <TextBox x:Name="LoginBox"
                     Text="{Binding Login, Mode=TwoWay}"
                     Watermark="например, smirnova"
                     MaxLength="50" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="Caption" Text="ПАРОЛЬ" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       x:Name="PasswordBox"
                       Text="{Binding Password, Mode=TwoWay}"
                       PasswordChar="{Binding PasswordChar}"
                       Watermark="••••••••"
                       MaxLength="128"
                       KeyDown="PasswordBox_KeyDown" />
              <Button Grid.Column="1" Classes="Subtle" Margin="6,0,0,0"
                      Command="{Binding TogglePasswordVisibilityCommand}"
                      ToolTip.Tip="Показать / скрыть пароль">
                <TextBlock Text="👁" />
              </Button>
            </Grid>
          </StackPanel>

          <TextBlock Classes="Error"
                     Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

          <Border Background="#F2D2D2" BorderBrush="#D8A0A0" BorderThickness="1" CornerRadius="6"
                  Padding="12,10"
                  IsVisible="{Binding IsLocked}">
            <StackPanel Spacing="2">
              <TextBlock Text="ДОСТУП ВРЕМЕННО ЗАБЛОКИРОВАН" FontSize="11" FontWeight="Bold" Foreground="#8C2F2F" />
              <TextBlock Foreground="#8C2F2F" FontSize="13">
                <Run Text="Повторите попытку через " />
                <Run Text="{Binding LockoutSecondsLeft}" FontWeight="Bold" />
                <Run Text=" с." />
              </TextBlock>
            </StackPanel>
          </Border>

          <Button Classes="Accent"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  FontSize="14" Padding="14,12"
                  Margin="0,6,0,0"
                  Command="{Binding SignInCommand}"
                  Content="Войти в систему" />

          <Border BorderBrush="#E0D5BE" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,10,0,0">
            <StackPanel Spacing="2">
              <TextBlock Classes="Caption" Text="ДЕМО-УЧЁТНЫЕ ЗАПИСИ" />
              <TextBlock FontSize="11" Foreground="#6B5E4E" Text="ivanov / chef123 — администратор (шеф-менеджер)" />
              <TextBlock FontSize="11" Foreground="#6B5E4E" Text="smirnova / coord123 — менеджер (банкетный координатор)" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
